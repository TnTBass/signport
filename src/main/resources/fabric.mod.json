{
	"schemaVersion": 1,
	"id": "signport",
	"version": "${version}",
	"name": "SignPort",
	"description": "A sign portal mod for quick travel between named anchors.",
	"authors": [
		"TnTBass",
		"approved"
	],
	"contact": {
		"homepage": "https://github.com/TnTBass/signport",
		"sources": "https://github.com/TnTBass/signport",
		"issues": "https://github.com/TnTBass/signport/issues"
	},
	"license": "LGPLv3",
	"icon": "assets/signport/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"tech.endorsed.signport.SignPort"
		],
		"client": [
			"tech.endorsed.signport.client.SignPortClient"
		],
		"modmenu": [
			"tech.endorsed.signport.client.config.SignPortModMenuApi"
		]
	},
	"mixins": [
		"signport.mixins.json"
	],
	"depends": {
