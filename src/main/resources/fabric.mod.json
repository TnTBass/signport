		"minecraft": ">=26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-permissions-api-v0": "*"
	},
	"recommends": {
		"bluemap": ">=5",
		"modmenu": ">=18.0.0-alpha.8"
